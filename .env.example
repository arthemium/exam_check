# Copy to .env, set your password, and keep .env private.
APP_ENV=development
# Host port and public URL must match.
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGINS=[]
COOKIE_SECURE=false
DB_PATH=/data/db/examcheck.db
UPLOAD_DIR=/data/uploads
# Original uploads are transcoded before the stored-image size limit is applied.
MAX_UPLOAD_BYTES=104857600
MAX_REQUEST_BYTES=125829120
# The API and durable job worker run in the same Go process.
ENABLE_WORKER=true
# One fixed account. A blank password disables login.
LOGIN_USERNAME=teacher
LOGIN_PASSWORD=
# Hostname for production HTTPS.
DOMAIN=exam.example.com
# Model selection lives in SQLite main_prompts.model, separately for OCR and checking.
OPENAI_API_KEY=
# Optional legacy seed for both models on database creation/upgrade; not a runtime override.
# Leave blank to seed gpt-6.1-terra for OCR and gpt-6.2-sol for checking.
OPENAI_MODEL=
