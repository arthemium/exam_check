{
  "name": "examcheck-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --mode api --host 127.0.0.1",
    "dev:api": "vite --mode api --host 127.0.0.1",
    "dev:demo": "vite --mode demo --host 127.0.0.1",
    "build": "tsc -b && vite build --mode api",
    "build:api": "tsc -b && vite build --mode api",
    "build:demo": "tsc -b && vite build --mode demo",
    "build:server": "npm run build && node scripts/copy-to-server.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
